# true: UI 학습용 데이터 / false: 아래 NestJS 서버에 실제 요청
EXPO_PUBLIC_USE_MOCK=true
# 실물 휴대폰: 개발 PC의 Wi-Fi IP 사용. localhost는 휴대폰 자신입니다.
# Android 에뮬레이터: http://10.0.2.2:3000 / iOS 시뮬레이터: http://localhost:3000
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
# 확인된 한의원 전화번호를 입력하세요. 비어 있으면 준비 중 안내를 표시합니다.
EXPO_PUBLIC_CLINIC_PHONE=
